# Copy this file to .env and fill in the values. Never commit .env (SRS SEC-07).
PORT=5000
# Local dev: run `npm run dev:db` and use the URI it prints, or a MongoDB Atlas replica-set URI.
MONGODB_URI=mongodb://127.0.0.1:27017/vps?replicaSet=testset
CORS_ORIGIN=http://localhost:5173

# Token-signing secret: a long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Passwords for the starting accounts created by `npm run seed` (admin1, att1, att2).
SEED_ADMIN_PASSWORD=
SEED_ATTENDANT_PASSWORD=
