{
  "name": "vps-server",
  "version": "0.1.0",
  "private": true,
  "description": "Vehicle Parking System - REST API (Express + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:db": "node scripts/dev-db.js",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke.js",
    "perf": "node scripts/perf.js",
    "lint": "eslint src tests scripts",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "setupFiles": ["<rootDir>/tests/setup-env.js"]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
